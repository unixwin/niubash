# Niubash interactive rc - example.
# Copy this file to ~/.niubashrc to adopt it. That file is Niubash's primary
# interactive entry point for aliases, environment, and shell startup.
#
# Defaults are a floor, not an identity (design §14.5): the built-in prompt
# renders only while nothing claims PS1. Anything that sets PS1 — your own
# line below, an enabled oh-my-bash theme, `eval "$(starship init bash)"` —
# owns the prompt completely, and disabling it lets this floor render again.

# ── Floor knobs (built-in defaults only; never fight an external prompt) ──
# NIU_PROMPT_CWD_STYLE='home'    # home | full | basename — cwd shape in the default prompt
# NIU_COMPLETION_STYLE='column'  # ide | column | list | inline — completion menu style

# Normalize HOME when it was not inherited from the environment.
if [ -z "${HOME:-}" ] && [ -n "${USERPROFILE:-}" ]; then
  case "$USERPROFILE" in
    /[A-Za-z]/*)
      __niubash_home_drive="${USERPROFILE#/}"
      __niubash_home_drive="${__niubash_home_drive%%/*}"
      __niubash_home_rest="${USERPROFILE#/$__niubash_home_drive/}"
      HOME="$__niubash_home_drive:/$__niubash_home_rest"
      ;;
    *)
      HOME="${USERPROFILE//\\//}"
      ;;
  esac
  export HOME
fi
unset __niubash_home_drive __niubash_home_rest

# ── External frameworks (oh-my-bash / bash-it / starship) ──
# Prefer the plugin manager over hand-writing loaders:
#   niu plugin add oh-my-bash          # install from the catalog (untrusted)
#   niu plugin trust oh-my-bash        # review, then pass the execution gate
#   niu plugin enable oh-my-bash       # records the source in the manifest
#   niu plugin enable agnoster         # theme pick -> OSH_THEME in the loader
#   niu plugin disable oh-my-bash      # manifest updated; the floor returns
#
# Since niubash#359 (v1.4.2) no plugin verb writes this file. `enable`/`disable`
# update the manifest (`~/.niubash/plugins.json` +
# `~/.niubash/sources/registry.json`) and regenerate the derived loader
# `~/.niubash/generated/plugins.niu`, which the host sources BEFORE this rc —
# your own PS1/alias/function lines below always win.
# `niu plugin list` / `niu plugin discover` report the current state, and
# `niu plugin sync` reconciles a hand-edited spec with reality.
#
# Two conditions keep the loader off:
#   NIU_PLUGIN_LOADER=off              # rollback switch (also false/0/no):
#                                      # skip the loader; unsetting rolls forward
#   legacy `# >>> niu source …` / `# <<< niu source …` managed blocks still in
#   this rc                            # double-execution guard: the old block is
#                                      # the live path. `niu plugin migrate-rc`
#                                      # (read-only; `--diff` publishes a
#                                      # candidate rc under
#                                      # `~/.niubash/candidates/`) diagnoses —
#                                      # removal is always your own edit.
#
# starship needs no source; its own init claims PS1 per prompt:
#   eval "$(starship init bash)"

# ── Personal aliases and environment ──
alias grep='grep --color=auto'
alias ll='ls -la'
alias la='ls -a'
alias e='exit'

export EDITOR='vim'
export PAGER='less'
