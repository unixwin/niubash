# Winuxsh interactive rc - example.
# Copy this file to ~/.winuxshrc to adopt it. That file is Winuxsh's primary
# interactive entry point for aliases, plugins, and shell startup.

WINUXSH_THEME=p10-classic
WINUXSH_THEME_PLUGIN=theme-p10-classic
WINUXSH_PROMPT_SYMBOL="❯"
export WINUXSH_THEME WINUXSH_THEME_PLUGIN WINUXSH_PROMPT_SYMBOL

# Official bundled source plugins. Theme is selected separately above.
WINUXSH_PLUGINS=(prompt-core git common-aliases path-tools extract)

# Normalize HOME when it was not inherited from the environment.
if [ -z "${HOME:-}" ] && [ -n "${USERPROFILE:-}" ]; then
  case "$USERPROFILE" in
    /[A-Za-z]/*)
      __winuxsh_home_drive="${USERPROFILE#/}"
      __winuxsh_home_drive="${__winuxsh_home_drive%%/*}"
      __winuxsh_home_rest="${USERPROFILE#/$__winuxsh_home_drive/}"
      HOME="$__winuxsh_home_drive:/$__winuxsh_home_rest"
      ;;
    *)
      HOME="${USERPROFILE//\\//}"
      ;;
  esac
  export HOME
fi

# Locate the bundled oh-my-winuxsh framework if WINUXSH is not set.
if [ -z "${WINUXSH:-}" ]; then
  for __winuxsh_bundle in "$HOME/.oh-my-winuxsh" "$HOME/.winuxsh/oh-my-winuxsh" "$HOME/.winuxsh/bundles/oh-my-winuxsh"/*; do
    if [ -f "$__winuxsh_bundle/oh-my-winuxsh.winux" ]; then
      WINUXSH="$__winuxsh_bundle"
      export WINUXSH
      break
    fi
  done
fi

[ -f "$WINUXSH/oh-my-winuxsh.winux" ] && . "$WINUXSH/oh-my-winuxsh.winux"

# Personal aliases and environment.
alias grep='grep --color=auto'
alias ll='ls -la'
alias la='ls -a'
alias e='exit'

export EDITOR='vim'
export PAGER='less'

unset __winuxsh_bundle
